<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeviceAccountingWinUi.UserControls.BasicDataLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeviceAccountingWinUi.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Назад -->
            <ColumnDefinition Width="*"/>
            <!-- Центр -->
            <ColumnDefinition Width="Auto"/>
            <!-- Правая панель -->
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: кнопка Назад -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="0,0,20,0">
            <Button Content="←"
                    Width="100"
                    Click="BackButton_Click"/>
        </StackPanel>

        <!-- Средняя колонка (место для таблицы) -->
        <ContentPresenter Grid.Column="1"
                          x:Name="CenterContentPresenter"
                          Content="{x:Bind CenterContent, Mode=OneWay}"/>

        <!-- Правая колонка (место для панели редактирования) -->
        <ContentPresenter Grid.Column="2"
                          x:Name="RightContentPresenter"
                          Content="{x:Bind RightContent, Mode=OneWay}"/>
    </Grid>
</UserControl>
