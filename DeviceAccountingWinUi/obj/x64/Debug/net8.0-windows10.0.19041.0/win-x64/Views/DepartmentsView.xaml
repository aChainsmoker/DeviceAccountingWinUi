<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="DeviceAccountingWinUi.Views.DepartmentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeviceAccountingWinUi.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
                          >

    <Grid Padding="10">
        <controls:DataGrid x:ConnectionId='2' 
            x:Name="DepartmentDataGrid"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Departments}">

            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <controls:DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                <controls:DataGridTextColumn Header="Short Name" Binding="{Binding ShortName}" Width="Auto"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>


        <!-- Кнопка Редактировать -->
        <Button x:ConnectionId='3' Content="Редактировать"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="10"
                Width="120"
                                        
                Canvas.ZIndex="3"/>

        <!-- Панель редактирования -->
        <StackPanel x:ConnectionId='4' x:Name="EditPanel"
                    Visibility="Collapsed"
                    Background="Transparent"
                    Padding="10"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="auto"
                    Spacing="5">

            <!-- Радиокнопки режима -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton x:ConnectionId='9' x:Name="AddRadio" Content="Добавление"                            />
                <RadioButton x:ConnectionId='10' x:Name="EditRadio" Content="Изменение"                            />
                <RadioButton x:ConnectionId='11' x:Name="DeleteRadio" Content="Удаление"                            />
            </StackPanel>

            <!-- Поля для данных -->
            <TextBox x:ConnectionId='5' x:Name="IdBox" Header="ID"/>
            <TextBox x:ConnectionId='6' x:Name="FullNameBox" Header="Full Name"/>
            <TextBox x:ConnectionId='7' x:Name="ShortNameBox" Header="Short Name"/>

            <!-- Кнопка Применить -->
            <Button x:ConnectionId='8' Content="Применить"                        />
        </StackPanel>
    </Grid>
</Page>

