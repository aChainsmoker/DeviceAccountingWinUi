<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="DeviceAccountingWinUi.Views.WorkersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeviceAccountingWinUi.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
                          >

    <Grid Padding="10">
        <!-- DataGrid -->
        <controls:DataGrid x:ConnectionId='2' 
            x:Name="WorkerDataGrid"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Workers}">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <controls:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <controls:DataGridTextColumn Header="Role ID" Binding="{Binding RoleId}" Width="Auto"/>
                <controls:DataGridTextColumn Header="Department ID" Binding="{Binding DepartmentId}" Width="Auto"/>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- Кнопка Редактировать -->
        <Button x:ConnectionId='3' Content="Редактировать"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="10"
                Width="120"
                                        
                Canvas.ZIndex="3"/>

        <!-- Панель редактирования -->
        <StackPanel x:ConnectionId='4' x:Name="EditPanel"
                    Visibility="Collapsed"
                    Background="Transparent"
                    Padding="10"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="auto"
                    Spacing="5"
                  >

            <!-- Радиокнопки -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton x:ConnectionId='10' x:Name="AddRadio" Content="Добавление"                            />
                <RadioButton x:ConnectionId='11' x:Name="EditRadio" Content="Изменение"                            />
                <RadioButton x:ConnectionId='12' x:Name="DeleteRadio" Content="Удаление"                            />
            </StackPanel>

            <!-- Поля для данных -->
            <TextBox x:ConnectionId='5' x:Name="IdBox" Header="ID"/>
            <TextBox x:ConnectionId='6' x:Name="NameBox" Header="Name"/>
            <TextBox x:ConnectionId='7' x:Name="RoleIdBox" Header="Role ID"/>
            <TextBox x:ConnectionId='8' x:Name="DepartmentIdBox" Header="Department ID"/>

            <!-- Кнопка Применить -->
            <Button x:ConnectionId='9' Content="Применить"                        />
        </StackPanel>
    </Grid>
</Page>

