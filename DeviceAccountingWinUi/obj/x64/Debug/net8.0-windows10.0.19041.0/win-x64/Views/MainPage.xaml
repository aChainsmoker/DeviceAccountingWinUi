<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeviceAccountingWinUi.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Заголовок приложения -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="DeviceAccounting"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="28"
               FontWeight="Bold"
               Foreground="White"
               Margin="0,20,0,20"/>

        <!-- StackPanel с кнопками -->
        <StackPanel Grid.Row="1" Grid.Column="1" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Center" 
                Spacing="15">

            <HyperlinkButton x:ConnectionId='3' Content="Devices" Name="btn0"                   
                             Background="#302c2b" 
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="30"
                Height="60"
               />

            <HyperlinkButton x:ConnectionId='4' Content="Workers" Name="btn1"                   
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="30"
                Height="60"
                />

            <HyperlinkButton x:ConnectionId='5' Content="Departments" Name="btn2"                   
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="30"
                Height="60"
                />
            <HyperlinkButton x:ConnectionId='6' Content="Device Transfers" Name="btn3"                   
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="30"
                Height="60"
                />
            <HyperlinkButton x:ConnectionId='7' Content="Devices by Department" Name="btn4"                   
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="30"
                Height="60"
                />
            <HyperlinkButton x:ConnectionId='8' Content="Rooms by Department" Name="btn5"                   
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="30"
                Height="60"
                />
            <HyperlinkButton x:ConnectionId='9' Content="Devices by Worker" Name="btn6"                   
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                FontSize="30"
                Height="60"
                />
        </StackPanel>
        <!-- Правый нижний угол для ввода названия предприятия -->
        <StackPanel Grid.Row="2" Grid.Column="2" 
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Orientation="Horizontal" Spacing="10" Margin="0,0,20,20">
            <TextBlock Text="Organisation's Name:" VerticalAlignment="Center" Foreground="White" FontSize="16"/>
            <TextBox x:ConnectionId='2' x:Name="CompanyNameBox" Width="auto" PlaceholderText="Введите название предприятия" Text="{Binding CompanyName, Mode=TwoWay}"/>
        </StackPanel>


    </Grid>
</Page>

